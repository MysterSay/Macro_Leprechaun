{
  "name": "Clean Circle",
  "author": "Simon Schneegans",
  "license": "CC0-1.0",
  "themeVersion": "1.0",
  "engineVersion": 1,
  "maxMenuRadius": 160,
  "centerTextWrapWidth": 95,
  "drawChildrenBelow": true,
  "colors": {
    "action-icon-color": "rgba(255, 200, 225, 1)",
    "submenu-icon-color": "#333",
    "text-color": "#222",
    "background-color": "#fff"
  },
  "layers": [
    {
      "class": "arrow-layer",
      "content": "none"
    },
    {
      "class": "icon-layer",
      "content": "icon"
    },
    {
      "class": "quick-key",
      "content": "quick-select-key"
    }
  ]
}